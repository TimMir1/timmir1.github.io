```html
<!DOCTYPE html>
<html lang="ru" class="h-full bg-slate-950 text-slate-100">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>PlayButton CRM — Производство наград и кнопок</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- FontAwesome icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Vue 3 -->
    <script src="https://unpkg.com/vue@3/dist/vue.global.js"></script>
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@600;700&family=Roboto+Condensed:wght@700&family=Roboto:wght@400;500;700&display=swap" rel="stylesheet">
    <style>
        [v-cloak] { display: none; }
        .custom-scrollbar::-webkit-scrollbar { width: 6px; height: 6px; }
        .custom-scrollbar::-webkit-scrollbar-track { background: rgba(15, 23, 42, 0.6); }
        .custom-scrollbar::-webkit-scrollbar-thumb { background: rgba(51, 65, 85, 0.8); border-radius: 4px; }
        .custom-scrollbar::-webkit-scrollbar-thumb:hover { background: rgba(71, 85, 105, 1); }

        .font-youtube { font-family: 'Oswald', sans-serif; letter-spacing: 0.5px; }
        
        /* Металлические градиенты для превью */
        .bg-silver-brushed {
            background: linear-gradient(135deg, #e2e8f0 0%, #cbd5e1 50%, #94a3b8 100%);
            box-shadow: inset 0 0 15px rgba(255,255,255,0.6);
        }
        .bg-gold-brushed {
            background: linear-gradient(135deg, #fef08a 0%, #fde047 30%, #eab308 70%, #ca8a04 100%);
            box-shadow: inset 0 0 15px rgba(255,255,255,0.6);
        }

        @media print {
            body * { visibility: hidden; }
            #printable-receipt, #printable-receipt * { visibility: visible; }
            #printable-receipt { position: absolute; left: 0; top: 0; width: 100%; color: black; background: white; }
        }
    </style>
</head>
<body class="h-full font-sans antialiased selection:bg-amber-500 selection:text-slate-900">
    <div id="app" v-cloak class="min-h-full flex flex-col">
        
        <!-- Шапка панели -->
        <header class="bg-slate-900/90 backdrop-blur border-b border-slate-800 sticky top-0 z-30">
            <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
                <div class="flex items-center space-x-3">
                    <div class="w-10 h-10 rounded-xl bg-gradient-to-tr from-red-600 to-amber-500 flex items-center justify-center text-white font-bold text-xl shadow-lg shadow-red-600/20">
                        <i class="fa-solid fa-play"></i>
                    </div>
                    <div>
                        <div class="flex items-center space-x-2">
                            <h1 class="font-bold text-lg text-slate-100 leading-none">PlayButton CRM</h1>
                            <span class="bg-red-500/20 text-red-400 text-[10px] font-bold px-1.5 py-0.5 rounded border border-red-500/30">CNC 3.5</span>
                        </div>
                        <span class="text-xs text-slate-400">АКП 1220x4000x3мм • ЧПУ Производство</span>
                    </div>
                </div>

                <!-- Кнопки быстрых действий -->
                <div class="flex items-center space-x-2 sm:space-x-3">
                    <button @click="showSettingsModal = true" class="bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold px-3 py-2 rounded-xl border border-slate-700 transition flex items-center" title="Настройки цен и затрат">
                        <i class="fa-solid fa-sliders text-sky-400 mr-2"></i>
                        <span class="hidden sm:inline">Тарифы</span>
                    </button>

                    <button @click="showStockModal = true" class="bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-semibold px-3 py-2 rounded-xl border border-slate-700 transition flex items-center">
                        <i class="fa-solid fa-layer-group text-amber-400 mr-2"></i>
                        <span class="hidden sm:inline">Склад АКП: </span>
                        <span class="ml-1 font-bold text-amber-400">{{ stockSheets }} лист.</span>
                    </button>

                    <button @click="openCreateModal" class="bg-gradient-to-r from-red-600 to-amber-500 hover:from-red-500 hover:to-amber-400 text-white font-bold text-xs sm:text-sm px-4 py-2 rounded-xl shadow-lg shadow-red-600/20 transition flex items-center">
                        <i class="fa-solid fa-plus mr-1.5"></i>
                        <span>Новая кнопка</span>
                    </button>
                </div>
            </div>
        </header>

        <!-- Главный экран -->
        <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6 flex flex-col">
            
            <!-- Карточки ключевой метрики -->
            <div class="grid grid-cols-2 md:grid-cols-4 gap-3 mb-6">
                <div class="bg-slate-900/60 border border-slate-800 p-3.5 rounded-2xl flex items-center justify-between">
                    <div>
                        <div class="text-slate-400 text-[11px] font-semibold uppercase">В резке / сборке</div>
                        <div class="text-xl font-bold text-slate-100">{{ activeOrdersCount }} <span class="text-xs font-normal text-slate-400">кнопок</span></div>
                    </div>
                    <div class="w-9 h-9 rounded-xl bg-amber-500/10 text-amber-400 flex items-center justify-center text-lg">
                        <i class="fa-solid fa-gears"></i>
                    </div>
                </div>

                <div class="bg-slate-900/60 border border-slate-800 p-3.5 rounded-2xl flex items-center justify-between">
                    <div>
                        <div class="text-slate-400 text-[11px] font-semibold uppercase">Заказов за месяц</div>
                        <div class="text-xl font-bold text-slate-100">{{ orders.length }} <span class="text-xs font-normal text-slate-400">шт.</span></div>
                    </div>
                    <div class="w-9 h-9 rounded-xl bg-blue-500/10 text-blue-400 flex items-center justify-center text-lg">
                        <i class="fa-solid fa-award"></i>
                    </div>
                </div>

                <div class="bg-slate-900/60 border border-slate-800 p-3.5 rounded-2xl flex items-center justify-between">
                    <div>
                        <div class="text-slate-400 text-[11px] font-semibold uppercase">Общая выручка</div>
                        <div class="text-xl font-bold text-emerald-400">{{ totalRevenue.toLocaleString() }} ₽</div>
                    </div>
                    <div class="w-9 h-9 rounded-xl bg-emerald-500/10 text-emerald-400 flex items-center justify-center text-lg">
                        <i class="fa-solid fa-wallet"></i>
                    </div>
                </div>

                <div class="bg-slate-900/60 border border-slate-800 p-3.5 rounded-2xl flex items-center justify-between">
                    <div>
                        <div class="text-slate-400 text-[11px] font-semibold uppercase">Чистая маржа</div>
                        <div class="text-xl font-bold text-sky-400">{{ totalProfit.toLocaleString() }} ₽</div>
                    </div>
                    <div class="w-9 h-9 rounded-xl bg-sky-500/10 text-sky-400 flex items-center justify-center text-lg">
                        <i class="fa-solid fa-coins"></i>
                    </div>
                </div>
            </div>

            <!-- Управление видами и фильтрация -->
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-4 mb-6">
                <div class="flex items-center space-x-3 w-full md:w-auto">
                    <div class="relative flex-1 md:w-72">
                        <i class="fa-solid fa-magnifying-glass absolute left-3 top-2.5 text-slate-500 text-xs"></i>
                        <input v-model="searchQuery" placeholder="Поиск по каналу, клиенту или треку..." class="w-full bg-slate-900 border border-slate-800 rounded-xl pl-8 pr-3 py-1.5 text-xs text-slate-200 placeholder-slate-500 focus:outline-none focus:border-red-500">
                    </div>
                </div>

                <!-- Фильтрация по типу кнопки -->
                <div class="flex items-center space-x-2 text-xs w-full md:w-auto overflow-x-auto">
                    <span class="text-slate-400 font-medium">Модель:</span>
                    <button @click="filterType = 'all'" :class="filterType === 'all' ? 'bg-red-500/20 text-red-400 border-red-500/50' : 'bg-slate-900 text-slate-400 border-slate-800'" class="px-3 py-1 rounded-lg border transition">
                        Все ({{ orders.length }})
                    </button>
                    <button @click="filterType = 'silver'" :class="filterType === 'silver' ? 'bg-slate-300/20 text-slate-200 border-slate-400/50' : 'bg-slate-900 text-slate-400 border-slate-800'" class="px-3 py-1 rounded-lg border transition flex items-center">
                        <i class="fa-solid fa-square text-slate-300 mr-1.5 text-[10px]"></i> Серебро ({{ settings.silverPrice.toLocaleString() }} ₽)
                    </button>
                    <button @click="filterType = 'gold'" :class="filterType === 'gold' ? 'bg-amber-500/20 text-amber-400 border-amber-500/50' : 'bg-slate-900 text-slate-400 border-slate-800'" class="px-3 py-1 rounded-lg border transition flex items-center">
                        <i class="fa-solid fa-square text-amber-400 mr-1.5 text-[10px]"></i> Золото ({{ settings.goldPrice.toLocaleString() }} ₽)
                    </button>
                </div>
            </div>

            <!-- KANBAN ДОСКА ЭТАПОВ ПРОИЗВОДСТВА -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 flex-1 items-start">
                <div v-for="status in statuses" :key="status.id" class="bg-slate-900/40 rounded-2xl border border-slate-800/80 flex flex-col max-h-[calc(100vh-14rem)]">
                    
                    <!-- Шапка статуса -->
                    <div class="p-3.5 border-b border-slate-800 flex items-center justify-between bg-slate-900/80 rounded-t-2xl">
                        <div class="flex items-center space-x-2">
                            <span :class="status.badgeColor" class="w-2.5 h-2.5 rounded-full inline-block"></span>
                            <h3 class="font-bold text-xs text-slate-200 uppercase tracking-wider">{{ status.title }}</h3>
                        </div>
                        <span class="bg-slate-800 text-slate-300 text-[11px] font-bold px-2 py-0.5 rounded-full border border-slate-700">
                            {{ getFilteredOrdersByStatus(status.id).length }}
                        </span>
                    </div>

                    <!-- Список заказов -->
                    <div class="p-3 space-y-3 overflow-y-auto custom-scrollbar flex-1">
                        <div v-for="order in getFilteredOrdersByStatus(status.id)" :key="order.id" 
                            @click="selectOrder(order)"
                            class="bg-slate-900 hover:bg-slate-850 border border-slate-800 rounded-2xl p-3.5 shadow-lg cursor-pointer transition transform hover:-translate-y-0.5 relative group">
                            
                            <!-- Тип награды + Платформа -->
                            <div class="flex items-center justify-between mb-2">
                                <span :class="order.type === 'silver' ? 'bg-slate-700/60 text-slate-200 border-slate-500/40' : 'bg-amber-500/20 text-amber-300 border-amber-500/40'" class="text-[10px] font-bold px-2 py-0.5 rounded-md border flex items-center uppercase">
                                    <i class="fa-solid fa-play mr-1.5 text-[9px]"></i>
                                    {{ order.type === 'silver' ? 'Серебро 25х30' : 'Золото 35х43' }}
                                </span>

                                <span :class="order.source === 'avito' ? 'text-blue-400' : 'text-sky-400'" class="text-[10px] font-bold">
                                    <i :class="order.source === 'avito' ? 'fa-solid fa-bag-shopping' : 'fa-paper-plane'"></i>
                                    {{ order.source === 'avito' ? 'Avito' : 'Telegram' }}
                                </span>
                            </div>

                            <!-- Название YouTube Канала -->
                            <h4 class="font-bold text-slate-100 text-sm mb-1 group-hover:text-red-400 transition truncate">
                                {{ order.channelName || 'Без названия канала' }}
                            </h4>

                            <!-- Текст шильдика 5х1.2см -->
                            <div class="bg-slate-950/80 border border-slate-800 rounded-xl p-2 mb-2">
                                <div class="text-[9px] text-slate-500 uppercase font-mono">Шильдик 5x1.2см:</div>
                                <div class="text-xs text-amber-300 font-mono truncate">"{{ order.plaqueText }}"</div>
                            </div>

                            <!-- Финансовая раскладка -->
                            <div class="flex items-center justify-between text-[11px] pt-2 border-t border-slate-800/80">
                                <span class="text-slate-400 truncate max-w-[110px]"><i class="fa-regular fa-user mr-1 text-slate-500"></i>{{ order.clientName }}</span>
                                <div class="text-right">
                                    <span class="font-bold text-slate-100">{{ order.price.toLocaleString() }} ₽</span>
                                    <div class="text-[9px] text-emerald-400 font-semibold">+{{ (order.price - order.costPrice).toLocaleString() }}₽ маржа</div>
                                </div>
                            </div>

                        </div>

                        <div v-if="getFilteredOrdersByStatus(status.id).length === 0" class="text-center py-8 text-slate-600 text-xs border border-dashed border-slate-800 rounded-2xl">
                            Нет заказов
                        </div>
                    </div>
                </div>
            </div>

        </main>

        <!-- МОДАЛЬНОЕ ОКНО: Карточка заказа / Редактирование -->
        <div v-if="selectedOrder" class="fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-4 bg-slate-950/80 backdrop-blur-sm">
            <div class="bg-slate-900 border border-slate-800 rounded-2xl w-full max-w-4xl max-h-[92vh] flex flex-col shadow-2xl overflow-hidden">
                
                <!-- Шапка модалки -->
                <div class="p-4 border-b border-slate-800 flex items-center justify-between bg-slate-850">
                    <div class="flex items-center space-x-3">
                        <div :class="selectedOrder.type === 'silver' ? 'bg-slate-700 text-slate-200' : 'bg-amber-500/20 text-amber-400'" class="p-2.5 rounded-xl text-xl">
                            <i class="fa-solid fa-award"></i>
                        </div>
                        <div>
                            <h2 class="text-sm sm:text-base font-bold text-slate-100">
                                {{ selectedOrder.type === 'silver' ? 'Серебряная кнопка YouTube 25х30 см' : 'Золотая кнопка YouTube 35х43 см' }}
                            </h2>
                            <p class="text-[11px] text-slate-400">Заказ #{{ selectedOrder.id }} • {{ formatDate(selectedOrder.createdAt) }}</p>
                        </div>
                    </div>

                    <!-- Кнопки экспорта документов -->
                    <div class="flex items-center space-x-2">
                        <button @click="exportToWord(selectedOrder)" class="bg-blue-600 hover:bg-blue-500 text-white text-xs font-bold px-3 py-1.5 rounded-lg border border-blue-400/40 transition flex items-center" title="Открыть спецификацию в Word">
                            <i class="fa-solid fa-file-word mr-1.5"></i> Word
                        </button>
                        <button @click="exportToExcel(selectedOrder)" class="bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-bold px-3 py-1.5 rounded-lg border border-emerald-400/40 transition flex items-center" title="Открыть табель в Excel">
                            <i class="fa-solid fa-file-excel mr-1.5"></i> Excel
                        </button>
                        <button @click="openReceiptModal(selectedOrder)" class="bg-slate-800 hover:bg-slate-700 text-slate-200 text-xs font-bold px-3 py-1.5 rounded-lg border border-slate-700 transition flex items-center" title="Чек для печати">
                            <i class="fa-solid fa-receipt mr-1.5 text-amber-400"></i> Чек
                        </button>
                        <button @click="selectedOrder = null" class="text-slate-400 hover:text-slate-100 p-2 text-lg"><i class="fa-solid fa-xmark"></i></button>
                    </div>
                </div>

                <!-- Контент модалки -->
                <div class="p-5 overflow-y-auto custom-scrollbar space-y-5 flex-1">
                    
                    <!-- Изменение статуса изготовления -->
                    <div>
                        <label class="block text-[11px] font-bold text-slate-400 mb-2 uppercase">Этап производства на ЧПУ</label>
                        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
                            <button v-for="st in statuses" :key="st.id" 
                                @click="updateOrderStatus(selectedOrder, st.id)"
                                :class="selectedOrder.status === st.id ? 'bg-gradient-to-r from-red-600 to-amber-500 text-white font-bold border-red-500 shadow-md' : 'bg-slate-800 text-slate-300 border-slate-700 hover:bg-slate-750'"
                                class="p-2.5 rounded-xl border text-xs text-center transition flex flex-col items-center justify-center space-y-1">
                                <i :class="st.icon"></i>
                                <span>{{ st.title }}</span>
                            </button>
                        </div>
                    </div>

                    <!-- ИНТЕРАКТИВНОЕ ПРЕВЬЮ КНОПКИ YOUTUBE -->
                    <div class="bg-slate-950 p-4 rounded-2xl border border-slate-800 space-y-3">
                        <div class="flex justify-between items-center">
                            <span class="text-xs font-bold text-amber-400 uppercase flex items-center">
                                <i class="fa-solid fa-eye mr-2"></i> Визуализация макета для ЧПУ и лазера
                            </span>
                            <button @click="downloadSVG(selectedOrder)" class="text-xs text-sky-400 hover:text-sky-300 flex items-center">
                                <i class="fa-solid fa-file-code mr-1"></i> Скачать вектор (SVG)
                            </button>
                        </div>

                        <!-- Макет кнопки -->
                        <div class="flex justify-center py-4">
                            <div :class="selectedOrder.type === 'silver' ? 'bg-silver-brushed text-slate-800 border-slate-300' : 'bg-gold-brushed text-slate-900 border-amber-300'" 
                                 class="w-64 h-80 rounded-2xl p-4 flex flex-col items-center justify-between border-2 shadow-2xl relative transition-all">
                                
                                <!-- Значок YouTube (Play Triangle) -->
                                <div class="mt-6 w-20 h-20 bg-slate-950 rounded-2xl flex items-center justify-center shadow-lg border border-slate-800/40">
                                    <div class="w-0 h-0 border-y-[12px] border-y-transparent border-l-[22px] border